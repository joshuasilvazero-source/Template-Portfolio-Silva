# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit .env.local. Never put a Stripe SECRET key (sk_...) in this project.

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, and social previews.
SITE_URL=https://www.your-domain.com

# Contact form — Gmail SMTP with a Google App Password (not your normal password).
# myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: deliver inquiries to a different inbox than EMAIL_USER.
INQUIRY_TO=

# Stripe Payment Links (public URLs from Stripe → Payment Links). Leave blank to
# show the "Request this plan" fallback instead of a checkout button.
NEXT_PUBLIC_STRIPE_LINK_ESSENTIAL=
NEXT_PUBLIC_STRIPE_LINK_BUSINESS=
NEXT_PUBLIC_STRIPE_LINK_PREMIUM=
# Stripe customer portal login link (Stripe → Settings → Billing → Customer portal).
NEXT_PUBLIC_STRIPE_PORTAL_URL=
